# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas or local MongoDB)
# Falls back to in-memory JSON dev store when offline or not connected
MONGO_URI=mongodb://127.0.0.1:27017/animal_rescue

# Authentication (Required in production, minimum 32 random characters)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated URLs; required in production)
# Example: CORS_ORIGIN=https://animalrescue.org,http://localhost:8081
CORS_ORIGIN=

# Cloudinary Photo Storage (Required for production animal rescue photo uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Cloud Messaging / Push Notifications (Required for live rescuer push alerts)
# Provide individual credentials or a path to serviceAccountKey.json
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# FIREBASE_SERVICE_ACCOUNT_PATH=
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Google Gemini AI Urgency Triage (Optional)
# If empty, the system automatically uses the offline rule-based triage fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Dispatch & Escalation Configuration (Optional)
# Timeout in milliseconds before an unassigned case escalates to next rescuer / coordinator (default: 300000 = 5 min)
ESCALATION_TIMEOUT_MS=300000
# Background check interval in milliseconds to scan for expired escalation attempts (default: 15000 = 15 sec)
ESCALATION_CHECK_INTERVAL_MS=15000
# Lock timeout in milliseconds before a stuck 'processing' escalation is auto-recovered (default: 120000 = 2 min)
ESCALATION_LOCK_TIMEOUT_MS=120000
