PORT=5000
MONGO_URI=your_mongodb_atlas_connection_string_here
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Optional: turns on the real Gemini AI urgency check. Leave empty to use the built-in keyword rules.
# Get a key at https://aistudio.google.com (Get API key). Never commit the real key.
GEMINI_API_KEY=
# Optional: Gemini model to use. Change this if Google retires the default one.
GEMINI_MODEL=gemini-3.1-flash-lite
