# Mobile Application Environment Configuration
# API Base URL for backend services (includes /api/v1 suffix)
# Development with physical phone on same Wi-Fi: http://<YOUR_COMPUTER_LAN_IP>:5000/api/v1
# Development on web / emulator: http://localhost:5000/api/v1 (or http://10.0.2.2:5000/api/v1 for Android emulator)
# Production: https://api.yourdomain.com/api/v1
# EXPO_PUBLIC_API_URL=http://localhost:5000/api/v1
EXPO_PUBLIC_API_URL=http://YOUR_COMPUTER_LAN_IP:5000/api/v1
# Google Maps Platform API Key (Public Mobile Key)
# Create a restricted API key in Google Cloud Console: 
# 1. Enable "Maps SDK for Android" and "Maps SDK for iOS".
# 2. Restrict key to your Android package name (e.g., com.animalrescue.bengaluru) and SHA-1 fingerprint.
# Leave blank for local development fallback mode.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=


